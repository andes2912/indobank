{
    "name": "andes2912/indobank",
    "description": "List Bank of Indonesian",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "php",
        "csv",
        "indonesia",
        "bank",
        "nama bank"
    ],
    "authors": [
        {
            "name": "Andri Desmana",
            "email": "andridesmana29@gmail.com"
        }
    ],
    "require": {
        "php": "^7.4|^8.0",
        "parsecsv/php-parsecsv": "^1.1",
        "illuminate/support": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0|^10.0|^11.0",
        "orchestra/testbench": "^6.0|^7.0|^8.0|^9.0|^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Andes2912\\IndoBank\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Andes2912\\IndoBank\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Andes2912\\IndoBank\\IndoBankServiceProvider"
            ],
            "aliases": {
                "IndoBank": "Andes2912\\IndoBank\\IndoBank"
            }
        }
    },
    "homepage": "https://andridesmana.dev/",
    "prefer-stable": true
}
